{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrderCdcEvent",
  "type": "object",
  "description": "Debezium CDC envelope value for public.orders (JSON)",
  "required": ["payload"],
  "properties": {
    "schema": { "type": "object" },
    "payload": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "before": { "$ref": "#/definitions/Order" },
        "after": { "$ref": "#/definitions/Order" },
        "source": { "type": "object" },
        "op": { "type": "string", "enum": ["c", "u", "d", "r"] },
        "ts_ms": { "type": "integer" }
      }
    }
  },
  "definitions": {
    "Order": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "customer": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" }
      }
    }
  }
}
